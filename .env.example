# WooCommerce store URL (no trailing slash)
# Example: https://shop.nailsvilla.com
WOOCOMMERCE_URL=

# REST API keys from WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Public store URL used for checkout redirects (usually same as WOOCOMMERCE_URL)
NEXT_PUBLIC_WOOCOMMERCE_STORE_URL=

# Optional: only show products from this WooCommerce category ID
# WOOCOMMERCE_CATEGORY_ID=15
